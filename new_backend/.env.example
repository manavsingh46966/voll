# Copy to .env and fill in. Real values are shared privately — never commit .env.

# --- Required (server exits if missing) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>
JWT_KEY=<long-random-string>
JWT_EXPIRY=15m

# --- Server ---
SERVER_PORT=3000
# CORS_ORIGIN=http://localhost:8081

# --- Firebase Admin (Google sign-in) ---
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# --- AWS S3 (image uploads) ---
AWS_REGION=<region>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_S3_BUCKET=<bucket-name>
